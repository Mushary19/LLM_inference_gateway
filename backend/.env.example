# Copy to .env and replace the password. Must match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://inferenceflow:change-me-dev-only@localhost:5432/inferenceflow

# Required by pytest: the separate test-db container (docker compose up -d --wait test-db).
# Tests never fall back to DATABASE_URL. The database name must end with _test, and the
# server (host:port) must differ from DATABASE_URL's. Must match docker-compose.yml.
TEST_DATABASE_URL=postgresql+psycopg://inferenceflow_test:test-only-password@localhost:15432/inferenceflow_test

# Required by pytest: the separate test-redis container (docker compose up -d --wait test-redis).
# Tests never fall back to REDIS_URL, and it must be a different server (host:port) than REDIS_URL;
# a different database number on the same server is refused.
TEST_REDIS_URL=redis://localhost:16380/0

# Optional admission control limits (defaults shown).
# MAX_ACTIVE_REQUESTS=3
# MAX_QUEUED_REQUESTS=5
# SCHEDULER_ENABLED=true
# SCHEDULER_POLL_INTERVAL_SECONDS=0.1
# SIMULATED_INFERENCE_DELAY_SECONDS=2.0
# GPU_TOTAL_MEMORY_MB=16384
# GPU_MODEL_MEMORY_MB=10240
# GPU_RUNTIME_MEMORY_MB=1024
# KV_BLOCK_SIZE_MB=16
# SIMULATED_KV_BYTES_PER_TOKEN=524288

# Inference engine: "simulated" (default, no model) or "huggingface" (real CPU inference).
# INFERENCE_ENGINE=simulated
# HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# INFERENCE_DEVICE=cpu
# MAX_GENERATION_TOKENS=512
# INFERENCE_MAX_CONCURRENCY=1

# Model registry behind POST /v1/chat/completions and GET /v1/models: a JSON file mapping
# public model IDs to provider instances. Copy models.example.json to models.json and edit it.
# A relative path is resolved against this backend directory, not the working directory.
# Unset: only the fake provider's "fake-model" is served. Changes need a restart.
# MODEL_REGISTRY_FILE=models.json

# API keys for the providers in the registry, one variable per provider, named by that
# provider's "api_key_env". Keys never go in models.json. Never commit a real key.
# GROQ_API_KEY=

# CHAT_PROVIDER and OPENAI_COMPATIBLE_* are no longer used (see the README's "Model registry"
# section for the migration). CHAT_PROVIDER=openai_compatible without MODEL_REGISTRY_FILE
# stops the application at startup.

# Per-API-key rate limiting (Redis token bucket) for /v1. Defaults shown.
# Host-run backend -> the docker-compose "redis" service. Inside Compose: redis://redis:6379/0
# REDIS_URL=redis://localhost:16379/0
# Connect and command timeout; if Redis can't answer in time, /v1 requests get 503.
# REDIS_TIMEOUT_SECONDS=0.5
# Sustained rate (bucket refill) and burst (bucket capacity), per API key.
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# RATE_LIMIT_BURST=10

# Token quota given to applications created without `create-app --token-limit`.
# Quotas are lifetime allowances: they never reset automatically.
# DEFAULT_TOKEN_QUOTA=1000000

# Application logging (README "Logging and request IDs"). Defaults shown.
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Prometheus scraping of GET /metrics (README "Metrics"). Unset or empty: the endpoint is
# disabled (404). When set: at least 32 characters, sent as "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# METRICS_TOKEN=
